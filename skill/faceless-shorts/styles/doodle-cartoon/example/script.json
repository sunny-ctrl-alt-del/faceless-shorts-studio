    { "text": "When your friend says they're five minutes away.", "caps": "WHEN YOUR FRIEND SAYS | *FIVE MINUTES | *AWAY" },
    { "text": "Where are you? The movie starts in ten minutes!", "voice": "af_bella", "nocap": true },

    { "text": "Meanwhile, five minutes away.", "caps": "*MEANWHILE... | 5 MINUTES *AWAY" },
    { "text": "Okay, okay. I'm putting my shoes on.", "voice": "am_puck", "nocap": true },
    { "text": "You said that twenty minutes ago!", "voice": "af_bella", "nocap": true },
    { "text": "I'm here! Did I miss anything?", "voice": "am_puck", "nocap": true },
    { "text": "Just the whole movie.", "voice": "af_bella", "nocap": true },
    { "text": "Are you the Zara or the Milo? Be honest, tell me below.", "caps": "ZARA OR *MILO? | BE *HONEST | TELL ME *BELOW" }
